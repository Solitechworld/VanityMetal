# SwiftPM build products. ~580 MB here; reproducible from source in one command.
.build/
.swiftpm/
*.xcodeproj
*.xcworkspace

# The assembled app bundle. Built by ./build.sh; not a source artefact.
VanityMetal.app/

# Generated by ./build.sh --test (tee'd from VanityMetalVerify) and by the app.
verify-log.txt
session.log

# Generated documentation site. Built by site/build.py in CI and deployed to
# Pages; never committed, so it cannot go stale against the Markdown.
_site/

# Python bytecode from running the Tools/ verifiers. A .pyc embeds the absolute
# path of the source it was compiled from, so this is not only noise.
__pycache__/
*.pyc

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# NEVER COMMIT THESE.
#
# The app writes found keys to ~/Library/Application Support/VanityMetal/,
# deliberately outside this tree, so there is nothing here to leak by default.
# These patterns exist so that a stray export dropped into the working copy
# cannot be committed by accident. A vanity private key is a real private key.
found-keys.json
*-keys.json
*.wif
exports/
